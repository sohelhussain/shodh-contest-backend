# Postgres
POSTGRES_USER=shodh
POSTGRES_PASSWORD=shodh_dev_password
POSTGRES_DB=shodh
DATABASE_URL=postgresql://shodh:shodh_dev_password@localhost:5432/shodh?schema=public

# API
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Dev auth fixture (trusted header auth: x-dev-user-id, signed with this secret)
DEV_AUTH_SECRET=change_me_dev_only

# Judge access, separate from participant API
JUDGE_API_TOKEN=change_me_judge_only

# Worker
WORKER_POLL_INTERVAL_MS=500
LEASE_SECONDS=30
HEARTBEAT_SECONDS=10
MAX_ATTEMPTS=3

# Runner: docker (real judging) or mock (test double)
RUNNER_MODE=docker
RUNNER_IMAGE=shodh-python-runner:1
DOCKER_HOST=unix:///var/run/docker.sock

# Sandbox limits
RUN_CPUS=0.5
RUN_MEMORY_MB=128
RUN_PIDS_LIMIT=32
RUN_WALL_TIME_MS=3000
RUN_OUTPUT_LIMIT_BYTES=65536

# Failpoints for deterministic fault tests (empty = off)
# examples: runner_crash, crash_before_ack, crash_after_claim
FAILPOINT=
